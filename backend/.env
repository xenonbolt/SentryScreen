# ── Adverse Media Screening Copilot — Backend Environment Config ──────────────

# Embedding model (Hugging Face model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
TOP_K_RESULTS=15
RELEVANCE_THRESHOLD=0.20

# Entity resolution fuzzy match threshold (0-100)
FUZZY_MATCH_THRESHOLD=65

# Optional: On-Prem LLM via Ollama
# Set to "true" to enable LLM-generated summaries
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# API server
HOST=0.0.0.0
PORT=8000
